{
  "name": "notasmax-api-postgresql",
  "version": "1.0.0",
  "private": true,
  "description": "Local and CI foundation for the Notas Max API.",
  "main": "dist/functions/*.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "func start",
    "test": "node --require ./test/load-local-settings.cjs --test ./test/health.test.cjs ./test/auth.test.cjs ./test/subject.test.cjs ./test/class.test.cjs ./test/simulation.test.cjs ./test/result.test.cjs ./test/database-safety.test.cjs ./test/postgres.integration.test.cjs",
    "test:integration": "node ./test/run-integration-tests.cjs",
    "db:migrate:latest": "knex migrate:latest --knexfile knexfile.cjs --env development",
    "db:migrate:status": "knex migrate:list --knexfile knexfile.cjs --env development",
    "db:seed:admin": "node ./seed/admin.cjs"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "argon2": "0.45.1",
    "knex": "3.3.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
